# ------------------------------------------------------------------
# Environment variables for crystic.ca
# ------------------------------------------------------------------
# Copy this file to ".env.local" for local development:
#     cp .env.example .env.local
# On Railway, you set these same variables in each service's "Variables" tab.
#
# IMPORTANT: The values below are IDENTICAL for the live site and the
# staging site, because both are meant to read images from the SAME
# Backblaze bucket/folder. That shared folder is what keeps you from
# storing every image twice.
# ------------------------------------------------------------------

# The public base URL of your Backblaze B2 bucket.
# Example (Backblaze "friendly URL" format):
#   https://f000.backblazeb2.com/file/crystic-media
# You will get this exact value from the Backblaze dashboard (see the guide).
NEXT_PUBLIC_B2_BUCKET_URL=https://f000.backblazeb2.com/file/crystic-media

# A label shown in a small banner so you can instantly tell which site you're
# looking at. Set to "production" on the live service and "staging" on the
# staging service. This is the ONE variable that differs between them.
NEXT_PUBLIC_SITE_ENV=production
