# ------------------------------------------------------------------
# Environment variables for crystic.ca
# ------------------------------------------------------------------
# Copy this file to ".env.local" for local development:
#     cp .env.example .env.local
# On Railway, you set these same variables in each service's "Variables" tab.
# ------------------------------------------------------------------

# A label so you can instantly tell which site you're looking at.
# Set to "production" on the live service and "staging" on the staging
# service. On staging this shows a small orange "STAGING" banner.
NEXT_PUBLIC_SITE_ENV=production

# ---- Supabase (product catalog database) -------------------------
# These are safe to expose in the browser: the publishable key can only
# read the catalog (enforced by row-level security). Find them in the
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://hpkfqrcigdwntwcksuve.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ivJEAIw4nXWDGlqR5B9m7A_7IbpFDb7

# ---- Media (Backblaze B2 served via Cloudflare) ------------------
# Public base URL that product photos are served from. Once the custom
# domain is live this is https://img.crystic.ca. Before then you can point
# it at the raw B2 friendly URL, e.g.
#   https://f004.backblazeb2.com/file/crystic-media1
NEXT_PUBLIC_IMAGE_BASE_URL=https://img.crystic.ca

# ---- Media upload (server-side only — NEVER expose these) ---------
# Used only by scripts/upload-media.mjs to push photos into the B2 bucket.
# Create an application key scoped to the crystic bucket in the Backblaze
# dashboard. Leave these OUT of Railway/web env; set them locally when uploading.
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_BUCKET=crystic-media1
# B2_KEY_ID=
# B2_APP_KEY=
